{
  "name": "posts-media-codex-package",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "npm run build:api && npm run build:worker",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "start:dev:api": "nest start api --watch",
    "start:dev:worker": "nest start worker --watch",
    "start:prod:api": "node dist/apps/api/main.js",
    "start:prod:worker": "node dist/apps/worker/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint \"{apps,libs,prisma,scripts}/**/*.{ts,mts,js,mjs}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:worker": "jest --selectProjects worker --runInBand",
    "verify:runtime": "./scripts/verify-runtime-tools.sh",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.2.0",
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "7.0.0",
    "bullmq": "5.81.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fast-json-stable-stringify": "2.1.0",
    "minio": "8.0.7",
    "multer": "2.2.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.42.0",
    "@typescript-eslint/parser": "8.42.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "jest": "30.1.3",
    "prettier": "3.6.2",
    "prisma": "7.0.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  }
}
